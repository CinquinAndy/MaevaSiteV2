		"react-email": "6.11.8",
		"react-icons": "5.7.0",
		"react-leaflet": "5.0.0",
		"resend": "6.37.0",
		"sharp": "0.35.5",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.5",
		"three": "0.187.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@playwright/test": "1.65.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "0.187.0",
		"@vitejs/plugin-react": "6.2.1",
		"jsdom": "30.1.3",
		"playwright": "1.65.0",
		"tsx": "4.23.15",
		"tw-animate-css": "1.4.0",
