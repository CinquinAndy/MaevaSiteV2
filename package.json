{
	"name": "cinquin-maeva",
	"version": "3.0.0",
	"description": "Maeva Cinquin - with Payload CMS",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "cross-env NODE_ENV=production tsx src/scripts/migrate.ts && cross-env NODE_ENV=production next build",
		"dev": "next dev",
		"email": "email dev --dir src/emails --port 3001",
		"generate:importmap": "payload generate:importmap",
		"generate:types": "payload generate:types",
		"check": "biome check --write",
		"lint": "biome lint --write",
		"format": "biome format --write",
		"payload": "payload",
		"start": "next start",
		"test": "bun test tests",
		"fetch:cities": "tsx scripts/fetch-cities.ts",
		"scrape:reviews": "tsx scripts/scrape-google-reviews-simple.ts",
		"clean:reviews": "tsx scripts/clean-reviews.ts",
		"import:reviews": "tsx scripts/import-google-reviews-to-payload.ts",
		"download:avatars": "tsx scripts/download-review-avatars.ts",
		"upload:avatars": "tsx scripts/upload-avatars-to-payload.ts",
		"sync:reviews": "bun scrape:reviews && bun clean:reviews && bun import:reviews sync && bun download:avatars && bun upload:avatars"
	},
	"packageManager": "bun@1.4.4",
	"dependencies": {
		"@ai-sdk/google": "2.0.109",
		"@googlemaps/google-maps-services-js": "3.4.2",
		"@gsap/react": "2.1.2",
		"@payloadcms/db-postgres": "3.93.0",
		"@payloadcms/next": "3.93.0",
		"@payloadcms/payload-cloud": "3.93.0",
		"@payloadcms/richtext-lexical": "3.93.0",
		"@payloadcms/storage-s3": "3.93.0",
		"@payloadcms/ui": "3.93.0",
		"@radix-ui/react-accordion": "1.3.1",
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-dropdown-menu": "2.2.1",
		"@radix-ui/react-label": "2.1.17",
		"@radix-ui/react-navigation-menu": "1.4.1",
		"@radix-ui/react-separator": "1.2.0",
		"@radix-ui/react-slot": "1.5.0",
		"@radix-ui/react-tabs": "1.2.1",
		"@react-email/components": "1.0.12",
		"@react-three/drei": "10.7.9",
		"@react-three/fiber": "9.8.2",
		"@tabler/icons-react": "3.50.0",
		"@tailwindcss/postcss": "4.3.5",
		"@tailwindcss/typography": "0.5.20",
		"@types/leaflet": "1.9.22",
		"ai": "5.0.286",
		"cheerio": "1.2.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"cross-env": "10.1.0",
		"dotenv": "17.4.2",
		"embla-carousel-react": "8.6.0",
		"framer-motion": "12.43.0",
		"graphql": "16.15.0",
		"gsap": "3.15.1",
		"leaflet": "1.9.4",
		"lucide-react": "0.577.0",
		"motion": "12.43.0",
		"next": "16.4.5",
		"next-themes": "0.4.6",
		"payload": "3.93.0",
